{
  "name": "service-user-metadata",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/*maintenance*.cjs\" package.json eslint.config.mjs eslint-suppressions.json .prettierrc \".github/workflows/*.yml\" \"docs/{architecture,development,observability}.md\" \"specs/002-code-maintenance/*.md\"",
    "prepare": "node -e \"const fs=require('node:fs');if(!process.env.CI&&process.env.HUSKY!=='0'&&process.env.NODE_ENV!=='production'&&!(process.env.npm_config_omit||'').split(/[\\s,]+/).includes('dev')&&fs.existsSync('.git')&&fs.existsSync('.husky')&&fs.existsSync('node_modules/husky/bin.js'))require('node:child_process').execFileSync(process.execPath,['node_modules/husky/bin.js'],{stdio:'inherit'})\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test:maintenance": "node scripts/verify-maintenance.cjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "openapi": "node dist/swagger.js",
    "postbuild": "node dist/swagger.js",
    "contracts:service-user-metadata:gen": "npm --prefix ./contracts/service-user-metadata run gen",
    "contracts:service-user-metadata:build": "npm --prefix ./contracts/service-user-metadata run build",
    "contracts:service-user-metadata:publish": "npm --prefix ./contracts/service-user-metadata publish --access public",
    "start:local": "USER_METADATA_LOCAL_DEV=true NODE_ENV=development GENERATE_OPENAPI=false MONGODB_URI=mongodb://127.0.0.1:27017/user_metadata_local PORT=3004 nest start --watch",
    "seed:local": "USER_METADATA_LOCAL_DEV=true NODE_ENV=development MONGODB_URI=mongodb://127.0.0.1:27017/user_metadata_local node -r ts-node/register scripts/seed-local.cjs",
    "test:local:http": "USER_METADATA_LOCAL_DEV=true NODE_ENV=development MONGODB_URI=mongodb://127.0.0.1:27017/user_metadata_local node -r ts-node/register scripts/verify-local.cjs",
    "start:workshop-example": "USER_METADATA_LOCAL_DEV=true NODE_ENV=development GENERATE_OPENAPI=false WORKSHOP_PROGRESS_DEMO=true MONGODB_URI=mongodb://127.0.0.1:27017/user_metadata_local PORT=3004 nest start --watch",
    "test:workshop-example:http": "node scripts/verify-workshop-example.cjs",
    "test:admin-users:http": "USER_METADATA_LOCAL_DEV=true NODE_ENV=development MONGODB_URI=mongodb://127.0.0.1:27017/user_metadata_local node scripts/verify-admin-provisioning.cjs"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/microservices": "^11.1.3",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "11.1.1",
    "axios": "^1.11.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "mongoose": "^8.16.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@tmdjr/ngx-auth-client": "0.0.21",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "16.2.7",
    "openapi-typescript": "^7.9.1",
    "openapi-typescript-codegen": "^0.29.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "lint-staged": {
    "*.{ts,js,cjs,mjs,json,md,yml,yaml}": "prettier --write --ignore-unknown"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
