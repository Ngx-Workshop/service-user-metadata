  "info": {
    "title": "NGX service-user-metadata API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "UserMetadataDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "uuid": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "regular",
              "publisher",
              "admin"
            ]
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "default": "No description provided"
          },
          "__v": {
            "type": "number"
          }
        },
        "required": [
          "_id",
          "uuid",
          "role",
          "__v"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "PaginatedUserMetadataDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserMetadataDto"
            }
          },
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          }
        },
        "required": [
          "data",
          "total",
          "page",
          "limit",
          "totalPages"
        ]
      },
      "UpdateRoleDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateUserMetadataDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "default": "No description provided"
          }
        }
      },
      "JourneyEntryDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "PAGE",
              "ASSESSMENT_TEST",
              "CODING_LAB"
            ]
          },
          "name": {
            "type": "string"
          },
          "sortId": {
            "type": "number"
          },
          "resourceId": {
            "type": "string"
          }
        },
        "required": [
          "_id",
          "kind",
          "name",
          "sortId"
        ]
      },
      "EligibleWorkshopDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "sectionId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "level": {
            "type": "number"
          },
          "sortId": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "in-progress",
              "completed"
            ]
          },
          "viewedPageIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pageCount": {
            "type": "number"
          },
          "completedAssessmentIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assessmentCount": {
            "type": "number"
          },
          "assessmentsCompleted": {
            "type": "boolean"
          },
          "workshopDocuments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JourneyEntryDto"
            }
          }
        },
        "required": [
          "_id",
          "sectionId",
          "name",
          "summary",
          "level",
          "sortId",
          "status",
          "viewedPageIds",
          "pageCount",
          "completedAssessmentIds",
          "assessmentCount",
          "assessmentsCompleted",
          "workshopDocuments"
        ]
      },
      "WorkshopSectionProgressDto": {
        "type": "object",
        "properties": {
          "sectionId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "assessmentCompleted": {
            "type": "boolean"
          },
          "assessmentAvailable": {
            "type": "boolean"
          },
          "unlockedLevel": {
            "type": "number"
          },
          "totalCount": {
            "type": "number"
          },
          "completedCount": {
            "type": "number"
          },
          "lockedCount": {
            "type": "number"
          },
          "workshops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EligibleWorkshopDto"
            }
          }
        },
        "required": [
          "sectionId",
          "title",
          "description",
          "assessmentCompleted",
          "assessmentAvailable",
          "unlockedLevel",
          "totalCount",
          "completedCount",
          "lockedCount",
          "workshops"
        ]
      },
      "WorkshopProgressDto": {
        "type": "object",
        "properties": {
          "demo": {
            "type": "boolean"
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkshopSectionProgressDto"
            }
          }
        },
        "required": [
          "demo",
          "sections"
        ]
      },
      "WorkshopReadingDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "html": {
            "type": "string",
            "description": "Serialized document blocks; render as sanitized content"
          }
        },
        "required": [
          "name",
          "html"
        ]
      },
      "DemoAssessmentDto": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string",
            "enum": [
              "component",
              "database"
            ]
          }
        },
        "required": [
          "answer"
        ]
      },
      "DemoAssessmentResultDto": {
        "type": "object",
        "properties": {
          "correct": {
            "type": "boolean"
          },
          "catalog": {
            "$ref": "#/components/schemas/WorkshopProgressDto"
          }
        },
        "required": [
          "correct",
          "catalog"
        ]
      }
    }
  }
}